---
import avatar from "@assets/images/avatar.png";
import MemosList from "@components/memos/MemosList.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const MEMOS_SITE = "https://memos.flygeon.top";
---

<MainGridLayout title={i18n(I18nKey.memos)} description={i18n(I18nKey.memos)}>
	<MemosList
		avatarSrc={avatar.src}
		memosSite={MEMOS_SITE}
		client:only="svelte"
	/>
</MainGridLayout>
