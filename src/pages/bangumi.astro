---
import type {
	SubjectType,
	UserSubjectCollection,
	UserSubjectCollectionResponse,
} from "@/types/bangumi";
import BangumiSection from "../components/bangumi/BangumiSection.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const BANGUMI_USERNAME = "1250652";
const API_BASE = "https://api.bgm.tv/v0";
const PAGE_SIZE = 100;

async function fetchAllCollections(
	subjectType: SubjectType,
): Promise<UserSubjectCollection[]> {
	const allItems: UserSubjectCollection[] = [];
	let offset = 0;
	let total = 0;

	while (true) {
		const url = `${API_BASE}/users/${BANGUMI_USERNAME}/collections?subject_type=${subjectType}&limit=${PAGE_SIZE}&offset=${offset}`;
		
		try {
			const res = await fetch(url, {
				headers: {
					"User-Agent": "Flygeon/blog (https://flygeon.top)",
				},
				signal: AbortSignal.timeout(10000),
			});

			if (!res.ok) {
				console.error(
					`Failed to fetch bangumi collections: ${res.status} ${res.statusText}`,
				);
				break;
			}

			const data: UserSubjectCollectionResponse = await res.json();
			allItems.push(...data.data);
			total = data.total;
			offset += data.limit;

			if (offset >= total) {
				break;
			}
		} catch (error) {
			console.error(`Error fetching bangumi collections (subject_type=${subjectType}):`, error);
			break;
		}
	}

	return allItems;
}

let animeItems: UserSubjectCollection[] = [];

try {
	animeItems = await fetchAllCollections(2);
} catch (error) {
	console.error("Failed to fetch bangumi data, using empty fallback:", error);
}
---

<MainGridLayout title={i18n(I18nKey.bangumi)} description={i18n(I18nKey.bangumi)}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="mb-6">
        <h1 class="text-2xl font-bold mb-2 text-[var(--primary)]">我的Bangumi收藏</h1>
        <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
          <span>我的看番收藏</span>
          <span class="text-gray-300 dark:text-gray-600">|</span>
          <a
            href={`https://bgm.tv/user/${BANGUMI_USERNAME}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--primary)] hover:underline"
          >
            @{BANGUMI_USERNAME}
          </a>
        </div>
      </div>

      <BangumiSection sectionId="anime" items={animeItems} isActive={true} />
    </div>
  </div>
</MainGridLayout>
