---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import AboutStatistics from "../components/AboutStatistics.astro";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSiteStatistics } from "../utils/content-utils";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const stats = await getSiteStatistics();
const techStacks = [
	{
		name: "Astro",
		description: "现代化的内容驱动型 Web 框架",
		href: "https://astro.build/",
		icon: "material-symbols:rocket-launch-outline",
	},
	{
		name: "Fuwari",
		description: "简洁、优雅的 Astro 博客主题",
		href: "https://github.com/saicaca/fuwari",
		icon: "material-symbols:palette-outline",
	},
];
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex flex-col gap-4">
        <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
            <div class="card-base z-10 px-9 py-6 relative w-full ">
                <Markdown class="mt-2">
                    <Content />
                </Markdown>
            </div>
        </div>
        <AboutStatistics stats={stats} techStacks={techStacks} />
    </div>
</MainGridLayout>
