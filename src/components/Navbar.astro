---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import MusicPreview from "./music/MusicPreview.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

const navIcons: Record<string, string> = {
	"/": "material-symbols:home-outline-rounded",
	"/archive/": "material-symbols:inventory-2-outline-rounded",
	"/about/": "material-symbols:person-outline-rounded",
	"/friends/": "material-symbols:groups-outline-rounded",
	"/bangumi/": "material-symbols:movie-outline-rounded",
	"/music/": "material-symbols:library-music-outline-rounded",
	"https://www.travellings.cn/go.html": "material-symbols:train-outline-rounded",
};

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation sticky top-4 flex justify-center w-full px-4">
    <div id="navbar-inner" class:list={[
        className,
        "card-base !overflow-visible h-[4.5rem] !rounded-full grid grid-cols-[auto_1fr_auto] md:grid-cols-[1fr_auto_1fr] items-center px-3 sm:px-4 backdrop-blur-xl w-full"]}
        style="background: color-mix(in srgb, var(--card-bg) 85%, transparent); max-width: var(--page-width); box-shadow: var(--navbar-shadow, 0 4px 6px -1px rgba(0, 0, 0, 0.05));">
        
        <a href={url('/')} aria-label={siteConfig.title} id="navbar-title" class="justify-self-start btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95 overflow-hidden whitespace-nowrap">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2 shrink-0" />
                <span>{siteConfig.title}</span>
            </div>
        </a>

        <div class="hidden md:flex justify-self-center gap-2" id="navbar-nav">
            {links.map((l) => {
                const anchor = (
                    <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null} rel={l.external ? "noopener noreferrer" : null}
                       class="navbar-icon-button btn-plain scale-animation rounded-lg h-11 font-bold px-3 active:scale-95"
                    >
                        <div class="flex items-center">
                            <Icon name={navIcons[l.url] ?? "material-symbols:link-rounded"} class="text-[1.25rem] shrink-0" />
                            <span class="navbar-icon-button-label">{l.name}</span>
                            {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="navbar-icon-button-external text-[0.75rem] shrink-0 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                        </div>
                    </a>
                );

                // 音乐入口：悬浮时展开迷你播放器（与 /music 整页播放器共用同一引擎）
                if (!l.external && l.url === "/music/") {
                    return (
                        <div class="nav-music-wrap relative">
                            {anchor}
                            <div class="nav-music-pop">
                                <div class="nav-music-card card-base">
                                    <MusicPreview client:only="svelte" />
                                </div>
                            </div>
                        </div>
                    );
                }

                return anchor;
            })}
        </div>

        <div class="relative flex justify-self-end gap-1 items-center" id="navbar-actions">
            <Search client:only="svelte"></Search>
            <DisplaySettings client:only="svelte"></DisplaySettings>
            <button aria-label="Menu" name="Nav Menu" class="navbar-icon-button btn-plain scale-animation rounded-lg px-3 h-11 active:scale-90 md:!hidden cursor-pointer" id="nav-menu-switch" type="button">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem] pointer-events-none"></Icon>
                <span class="navbar-icon-button-label pointer-events-none">Menu</span>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
    </div>
</div>

<style>
    #navbar-inner {
        /* 宽度不走 CSS transition：它由 rAF 阻尼循环逐帧写入，
           再叠一层 50ms 补间会让两套动画互相追赶，表现为卡顿 */
        transition: box-shadow 0.2s ease, border 0.2s ease;
        border: 1px solid color-mix(in srgb, var(--card-bg) 60%, var(--primary) 15%);
        will-change: width;
    }
    
    #navbar-title {
        transition: opacity 0.2s ease, max-width 0.3s ease, padding 0.3s ease, margin 0.3s ease;
        overflow: hidden;
    }

    #navbar-actions {
        transition: opacity 0.2s ease;
    }

    /* ------- 音乐按钮 hover 迷你播放器 ------- */
    .nav-music-pop {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(6px);
        /* 上方留白同时充当鼠标从按钮移到面板的"桥梁"，避免中途丢失 hover */
        padding-top: 0.9rem;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
        z-index: 60;
    }

    .nav-music-wrap:hover .nav-music-pop,
    .nav-music-wrap:focus-within .nav-music-pop {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }

    .nav-music-card {
        background: color-mix(in srgb, var(--float-panel-bg) 92%, transparent);
        backdrop-filter: blur(14px);
        border: 1px solid color-mix(in srgb, var(--card-bg) 60%, var(--primary) 15%);
        box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.22);
        border-radius: var(--radius-large);
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-music-pop {
            transition: none;
        }
    }

    @media (min-width: 768px) {
        :global(#navbar.navbar-collapsed) #navbar-inner {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            padding-left: 0.75rem !important;
            padding-right: 0.75rem !important;
        }

        :global(#navbar.navbar-collapsed) #navbar-title {
            display: none !important;
        }

        :global(#navbar.navbar-collapsed) #navbar-actions {
            display: none !important;
        }

        :global(#navbar.navbar-collapsed) #navbar-nav {
            display: flex !important;
            justify-content: center !important;
            width: 100% !important;
            margin: 0 !important;
        }
    }
</style>

<script>
function loadButtonScript() {
    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function (e) {
            e.stopPropagation();
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

// swup 软导航会重复调用 init，若不解绑旧监听器会逐页累积，滚动时多套 rAF 循环互相争抢
let detachNavbarScroll = null;

function initNavbarScroll() {
    if (detachNavbarScroll) {
        detachNavbarScroll();
        detachNavbarScroll = null;
    }

    const navbar = document.getElementById("navbar");
    const navbarInner = document.getElementById("navbar-inner");
    if (!navbar || !navbarInner) return;

    const maxScroll = 400;
    const startWidth = 1200;
    const endWidth = 420;
    // 阻尼系数：每帧向目标推进的比例，越小越顺滑但跟手感越弱
    const EASE = 0.12;
    // 与目标差值小于此阈值即吸附并停止循环，避免无限逼近空转
    const EPSILON = 0.5;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let targetProgress = 0;
    let currentProgress = 0;
    let rafId = 0;
    let collapsed = null;

    function readTarget() {
        targetProgress = Math.min(Math.max(window.scrollY / maxScroll, 0), 1);
    }

    function paint(progress) {
        const currentWidth = startWidth - (startWidth - endWidth) * progress;
        navbarInner.style.maxWidth = `${currentWidth}px`;
        navbarInner.style.width = `${currentWidth}px`;

        const shadowOpacity = 0.05 + progress * 0.15;
        navbarInner.style.setProperty(
            '--navbar-shadow',
            `0 10px 25px -5px rgba(0, 0, 0, ${shadowOpacity}), 0 8px 10px -6px rgba(0, 0, 0, ${shadowOpacity})`
        );

        // 折叠状态加 5% 迟滞，防止在阈值附近抖动时反复增删 class 引发重排
        const nextCollapsed = collapsed
            ? progress > 0.65
            : progress > 0.7;
        if (nextCollapsed !== collapsed) {
            collapsed = nextCollapsed;
            navbar.classList.toggle("navbar-collapsed", nextCollapsed);
        }
    }

    function tick() {
        const delta = targetProgress - currentProgress;
        if (Math.abs(delta) < EPSILON / maxScroll) {
            currentProgress = targetProgress;
            paint(currentProgress);
            rafId = 0;
            return;
        }
        currentProgress += delta * EASE;
        paint(currentProgress);
        rafId = requestAnimationFrame(tick);
    }

    function onScroll() {
        readTarget();
        if (reduceMotion.matches) {
            currentProgress = targetProgress;
            paint(currentProgress);
            return;
        }
        if (!rafId) rafId = requestAnimationFrame(tick);
    }

    window.addEventListener("scroll", onScroll, { passive: true });

    detachNavbarScroll = () => {
        window.removeEventListener("scroll", onScroll);
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
    };

    readTarget();
    currentProgress = targetProgress;
    paint(currentProgress);
}

loadButtonScript();
initNavbarScroll();

document.addEventListener("swup:page:view", function () {
    loadButtonScript();
    const nb = document.getElementById("navbar");
    if (nb) {
        nb.classList.remove("navbar-collapsed");
    }
    initNavbarScroll();
});
</script>
