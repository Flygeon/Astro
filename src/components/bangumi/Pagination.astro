---
import { Icon } from "astro-icon/components";

interface Props {
	totalItems: number;
	itemsPerPage: number;
	currentPage: number;
	sectionId: string;
}

const { totalItems, itemsPerPage, currentPage, sectionId } = Astro.props;
const totalPages = Math.ceil(totalItems / itemsPerPage);

function generatePageNumbers(current: number, total: number) {
	const delta = 2;
	const range = [];
	const rangeWithDots = [];

	if (total <= 7) {
		for (let i = 1; i <= total; i++) {
			range.push(i);
		}
		return range;
	}

	const left = Math.max(2, current - delta);
	const right = Math.min(total - 1, current + delta);

	rangeWithDots.push(1);

	if (left > 2) {
		rangeWithDots.push("...");
	}

	for (let i = left; i <= right; i++) {
		rangeWithDots.push(i);
	}

	if (right < total - 1) {
		rangeWithDots.push("...");
	}

	if (total > 1) {
		rangeWithDots.push(total);
	}

	return rangeWithDots;
}

const pageNumbers = generatePageNumbers(currentPage, totalPages);
---

{totalPages > 1 && (
  <div class="responsive-pagination flex justify-center items-center mt-8" data-pagination-section={sectionId}>
    <div class="mobile-pagination flex items-center space-x-2">
      <button
        type="button"
        class="p-1.5 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition-colors duration-200"
        data-page="prev"
        data-section={sectionId}
        disabled={currentPage === 1}
        aria-label="上一页"
      >
        <Icon name="material-symbols:chevron-left-rounded" class="text-base" />
      </button>

      <div class="flex items-center space-x-1">
        <span class="text-sm text-gray-600 dark:text-gray-400">第</span>
        <span class="mobile-current-page px-2 py-1 text-sm font-medium bg-[var(--primary)] text-white rounded">{currentPage}</span>
        <span class="text-sm text-gray-600 dark:text-gray-400">页，共</span>
        <span class="mobile-total-pages px-2 py-1 text-sm font-medium bg-gray-100 text-gray-700 rounded dark:bg-gray-700 dark:text-gray-300">{totalPages}</span>
        <span class="text-sm text-gray-600 dark:text-gray-400">页</span>
      </div>

      <button
        type="button"
        class="p-1.5 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50 disabled:cursor-not-allowed dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 transition-colors duration-200"
        data-page="next"
        data-section={sectionId}
        disabled={currentPage === totalPages}
        aria-label="下一页"
      >
        <Icon name="material-symbols:chevron-right-rounded" class="text-base" />
      </button>
    </div>

    <div class="desktop-pagination hidden md:flex items-center space-x-1 ml-4">
      {pageNumbers.map((pageNum) =>
        pageNum === "..." ? (
          <span class="px-2 text-gray-400">...</span>
        ) : (
          <button
            type="button"
            class:list={[
              "min-w-8 h-8 rounded-md text-sm font-medium transition-colors duration-200",
              {
                "bg-[var(--primary)] text-white": pageNum === currentPage,
                "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600": pageNum !== currentPage
              }
            ]}
            data-page={pageNum}
            data-section={sectionId}
          >
            {pageNum}
          </button>
        )
      )}
    </div>
  </div>
)}

<script is:inline define:vars={{ sectionId }}>
  (function() {
    const ITEMS_PER_PAGE = 9;
    const PRIMARY_BG = 'bg-[var(--primary)]';
    const PRIMARY_TEXT = 'text-white';
    const DEFAULT_BG = 'bg-gray-100';
    const DEFAULT_TEXT = 'text-gray-700';
    const DEFAULT_HOVER = 'hover:bg-gray-200';
    const DARK_DEFAULT_BG = 'dark:bg-gray-700';
    const DARK_DEFAULT_TEXT = 'dark:text-gray-300';
    const DARK_DEFAULT_HOVER = 'dark:hover:bg-gray-600';

    function getAllItems(sectionId) {
      return Array.from(document.querySelectorAll(`[data-item-section="${sectionId}"]`));
    }

    function getVisibleItems(sectionId) {
      return getAllItems(sectionId).filter(item => !item.classList.contains('hidden'));
    }

    function loadVisibleImages(items) {
      items.forEach(item => {
        const img = item.querySelector('.bangumi-lazy-img');
        if (img && img.dataset.src && !img.src) {
          img.src = img.dataset.src;
          img.onload = function() {
            img.classList.remove('opacity-0');
          };
        }
      });
    }

    function showPage(sectionId, page) {
      const allItems = getAllItems(sectionId);
      const visibleItems = getVisibleItems(sectionId);

      allItems.forEach(item => {
        item.style.display = 'none';
      });

      const start = (page - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;
      const pageItems = visibleItems.slice(start, end);

      pageItems.forEach(item => {
        item.style.display = 'block';
      });

      loadVisibleImages(pageItems);
    }

    function getCurrentPage(sectionId) {
      const container = document.querySelector(`[data-pagination-section="${sectionId}"]`);
      if (!container) return 1;
      const currentPageEl = container.querySelector('.mobile-current-page');
      return currentPageEl ? parseInt(currentPageEl.textContent) || 1 : 1;
    }

    function updatePageDisplay(sectionId, page, visibleCount) {
      const container = document.querySelector(`[data-pagination-section="${sectionId}"]`);
      if (!container) return;

      const totalPages = Math.max(1, Math.ceil(visibleCount / ITEMS_PER_PAGE));

      const mobileCurrentPage = container.querySelector('.mobile-current-page');
      if (mobileCurrentPage) {
        mobileCurrentPage.textContent = page;
      }

      const mobileTotalPages = container.querySelector('.mobile-total-pages');
      if (mobileTotalPages) {
        mobileTotalPages.textContent = totalPages;
      }

      const desktopButtons = container.querySelectorAll('.desktop-pagination [data-page]');
      desktopButtons.forEach(btn => {
        const pageNum = parseInt(btn.dataset.page);
        if (pageNum === page) {
          btn.classList.remove(DEFAULT_BG, DEFAULT_TEXT, DEFAULT_HOVER, DARK_DEFAULT_BG, DARK_DEFAULT_TEXT, DARK_DEFAULT_HOVER);
          btn.classList.add(PRIMARY_BG, PRIMARY_TEXT);
        } else if (!isNaN(pageNum)) {
          btn.classList.remove(PRIMARY_BG, PRIMARY_TEXT);
          btn.classList.add(DEFAULT_BG, DEFAULT_TEXT, DEFAULT_HOVER, DARK_DEFAULT_BG, DARK_DEFAULT_TEXT, DARK_DEFAULT_HOVER);
        }
      });

      const prevButton = container.querySelector('[data-page="prev"]');
      const nextButton = container.querySelector('[data-page="next"]');
      if (prevButton) prevButton.disabled = page <= 1;
      if (nextButton) nextButton.disabled = page >= totalPages;
    }

    function initPagination() {
      const paginationContainer = document.querySelector(`[data-pagination-section="${sectionId}"]`);
      if (!paginationContainer) return;

      const buttons = paginationContainer.querySelectorAll('[data-page]');
      buttons.forEach(button => {
        button.addEventListener('click', function() {
          const pageAction = this.dataset.page;
          const currentSectionId = this.dataset.section;
          const visibleCount = getVisibleItems(currentSectionId).length;
          const totalPages = Math.ceil(visibleCount / ITEMS_PER_PAGE);
          let targetPage = 1;
          const currentPage = getCurrentPage(currentSectionId);

          if (pageAction === 'prev') {
            targetPage = Math.max(1, currentPage - 1);
          } else if (pageAction === 'next') {
            targetPage = Math.min(totalPages, currentPage + 1);
          } else {
            targetPage = parseInt(pageAction);
          }

          showPage(currentSectionId, targetPage);
          updatePageDisplay(currentSectionId, targetPage, visibleCount);
        });
      });

      paginationContainer.addEventListener('updatePagination', function(e) {
        const visibleCount = e.detail.visibleCount;
        showPage(sectionId, 1);
        updatePageDisplay(sectionId, 1, visibleCount);
      });
    }

    function initFirstPage() {
      const allItems = getAllItems(sectionId);
      if (allItems.length === 0) return;

      const visibleCount = getVisibleItems(sectionId).length;

      allItems.forEach(item => {
        item.style.display = 'none';
      });

      const visibleItems = getVisibleItems(sectionId);
      const pageItems = visibleItems.slice(0, ITEMS_PER_PAGE);
      pageItems.forEach(item => {
        item.style.display = 'block';
      });

      loadVisibleImages(pageItems);
      updatePageDisplay(sectionId, 1, visibleCount);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initFirstPage();
        initPagination();
      });
    } else {
      initFirstPage();
      initPagination();
    }
  })();
</script>
