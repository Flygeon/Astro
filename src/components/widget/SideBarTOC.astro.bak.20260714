---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));

const cleanHash = (text: string) => {
	let i = text.lastIndexOf("#");
	return i === text.length - 1 ? text.substring(0, i) : text;
};

let topIndex = 1;

const maxLevel = siteConfig.toc.depth;
---

{isPostsRoute && (
	<div class:list={["card-base p-4 transition w-full", className]}>
		<div class="flex items-center gap-2 mb-3">
			<div class="w-1 h-5 rounded-sm bg-[var(--primary)]"></div>
			<span class="text-lg font-bold text-neutral-900 dark:text-neutral-100">目录</span>
		</div>
		<nav id="sidebar-toc" class="relative w-full max-h-[60vh] overflow-y-auto hide-scrollbar">
			{headings.filter((heading) => heading.depth < minDepth + maxLevel).map((heading) => (
				<a
					href={`#${heading.slug}`}
					data-toc-link
					data-slug={heading.slug}
					class:list={[
						"sidebar-toc-link relative z-[1] px-2 flex gap-2 transition w-full min-h-9 rounded-xl py-2",
						{
							"hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)]": true,
						},
					]}
				>
					<div
						class:list={[
							"transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
							{
								"bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": heading.depth == minDepth,
								"ml-4": heading.depth == minDepth + 1,
								"ml-8": heading.depth == minDepth + 2,
							},
						]}
					>
						{heading.depth == minDepth && topIndex++}
						{heading.depth == minDepth + 1 && (
							<div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>
						)}
						{heading.depth == minDepth + 2 && (
							<div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>
						)}
					</div>
					<div class="transition text-sm text-50">{cleanHash(heading.text)}</div>
				</a>
			))}
			<div id="sidebar-active-indicator" style="opacity: 0"></div>
		</nav>
	</div>
)}

<style is:global>
	/* 章节高亮块：绝对定位于 nav 内，置于链接文字之下、卡片背景之上 */
	#sidebar-active-indicator {
		position: absolute;
		left: 0;
		right: 0;
		z-index: 0;
		border-radius: 0.75rem;
		/* 用对比度更高的 --toc-item-active，替代过浅的 --toc-btn-hover */
		background-color: var(--toc-item-active);
		border: 2px dashed transparent;
		pointer-events: none;
		transition:
			top 0.2s ease,
			height 0.2s ease,
			opacity 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	/* 左侧品牌色竖条，强化“当前章节”可读性 */
	#sidebar-active-indicator::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.5rem;
		bottom: 0.5rem;
		width: 3px;
		border-radius: 3px;
		background: var(--primary);
	}

	/* 悬停目录时，高亮块变为虚线边框、底色透明（复刻原版交互） */
	#sidebar-toc:hover #sidebar-active-indicator {
		background-color: transparent;
		border-color: var(--toc-btn-active);
	}
	#sidebar-toc:hover #sidebar-active-indicator::before {
		background: var(--toc-btn-active);
	}

	/* 高亮区间内文字加粗并加深，进一步提升对比度 */
	#sidebar-toc .sidebar-toc-link.sidebar-toc-active {
		font-weight: 600;
	}
	#sidebar-toc .sidebar-toc-link.sidebar-toc-active .text-50,
	#sidebar-toc .sidebar-toc-link.sidebar-toc-active .text-30 {
		color: var(--deep-text);
	}
	html.dark #sidebar-toc .sidebar-toc-link.sidebar-toc-active .text-50,
	html.dark #sidebar-toc .sidebar-toc-link.sidebar-toc-active .text-30 {
		color: rgb(245 245 245);
	}

	/* 托底：底部渐隐遮罩，仅作用于可视区最末 ~10%，不影响高亮块主体 */
	#sidebar-toc {
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 90%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 90%, transparent 100%);
	}
</style>

<script>
(function () {
	const NS = "__sidebarToc";
	if (window[NS]) return;
	window[NS] = true;

	let indicator = null;
	let entries = [];
	let active = [];
	let anchorNavTarget = null;
	let currentToc = null;
	let ticking = false;

	function getToc() {
		return document.getElementById("sidebar-toc");
	}

	function setup() {
		const toc = getToc();
		if (!toc) {
			currentToc = null;
			return;
		}
		if (toc === currentToc) return;
		currentToc = toc;

		indicator = document.getElementById("sidebar-active-indicator");
		const links = Array.from(toc.querySelectorAll("a[data-toc-link]"));
		if (links.length === 0) {
			clearBlock();
			return;
		}

		entries = links.map((link) => {
			const slug = link.getAttribute("data-slug");
			const heading = slug ? document.getElementById(slug) : null;
			return { link, heading };
		});
		active = new Array(entries.length).fill(false);

		toc.addEventListener("click", onAnchorClick, { capture: true });

		computeActive();
		update();
	}

	// 以视口 20% 高度为阅读触发线，当前章节 = 最后一个 top <= trigger 的 heading
	function computeActive() {
		const trigger = window.innerHeight * 0.2;
		let idx = -1;
		for (let i = 0; i < entries.length; i++) {
			const h = entries[i].heading;
			if (!h) continue;
			const top = h.getBoundingClientRect().top;
			if (top <= trigger) {
				idx = i;
			} else {
				break;
			}
		}

		active = new Array(entries.length).fill(false);
		if (idx !== -1) active[idx] = true;

		// 点击目录锚点后，保持目标高亮直到它滚过触发线
		if (anchorNavTarget) {
			const tIdx = entries.findIndex((e) => e.heading === anchorNavTarget);
			if (tIdx !== -1) {
				if (anchorNavTarget.getBoundingClientRect().top > trigger) {
					active = new Array(entries.length).fill(false);
					active[tIdx] = true;
				} else {
					anchorNavTarget = null;
				}
			}
		}
	}

	function schedule() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			ticking = false;
			computeActive();
			update();
		});
	}

	function update() {
		requestAnimationFrame(() => {
			const toc = getToc();
			if (!toc || !indicator || !entries.length) return;

			let min = -1;
			let max = -1;
			for (let i = 0; i < active.length; i++) {
				if (active[i]) {
					if (min === -1) min = i;
					max = i;
				}
			}
			if (min === -1) {
				clearBlock();
				return;
			}

			const parentOffset = toc.getBoundingClientRect().top;
			const scrollOffset = toc.scrollTop;
			const top =
				entries[min].link.getBoundingClientRect().top - parentOffset + scrollOffset;
			const bottom =
				entries[max].link.getBoundingClientRect().bottom - parentOffset + scrollOffset;

			indicator.style.opacity = "1";
			indicator.style.top = top + "px";
			indicator.style.height = bottom - top + "px";

			for (let i = 0; i < entries.length; i++) {
				entries[i].link.classList.toggle("sidebar-toc-active", i >= min && i <= max);
			}
		});
	}

	function clearBlock() {
		if (indicator) indicator.style.opacity = "0";
		entries.forEach((e) => e.link.classList.remove("sidebar-toc-active"));
	}

	function onAnchorClick(event) {
		const anchor = event
			.composedPath()
			.find((el) => el instanceof HTMLAnchorElement);
		if (!anchor) return;
		const id = decodeURIComponent((anchor.hash || "").substring(1));
		const idx = entries.findIndex((e) => e.heading && e.heading.id === id);
		anchorNavTarget = idx !== -1 ? entries[idx].heading : null;
	}

	// 首屏初始化
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setup, { once: true });
	} else {
		setup();
	}

	// 滚动与尺寸变化时重新计算
	window.addEventListener("scroll", schedule, { passive: true });
	window.addEventListener("resize", schedule, { passive: true });

	// Swup 客户端导航：换页后重新初始化（Astro 内联脚本不会随容器重跑）
	function onPageView() {
		currentToc = null;
		anchorNavTarget = null;
		requestAnimationFrame(setup);
	}
	function attachSwup() {
		if (window.swup && window.swup.hooks) {
			window.swup.hooks.on("page:view", onPageView);
		}
	}
	if (window.swup && window.swup.hooks) {
		attachSwup();
	} else {
		document.addEventListener("swup:enable", attachSwup, { once: true });
	}
})();
</script>
