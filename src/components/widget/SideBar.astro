---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import RouteSwitch from "./RouteSwitch.astro";
import SideBarTOC from "./SideBarTOC.astro";
import Tag from "./Tags.astro";
import UmamiStats from "./UmamiStats.astro";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        {isPostsRoute && headings.length > 0 ? (
            <SideBarTOC headings={headings}></SideBarTOC>
        ) : (
            <>
                <RouteSwitch class="onload-animation" style="animation-delay: 100ms"></RouteSwitch>
                <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
                <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
                <UmamiStats class="onload-animation" style="animation-delay: 250ms"></UmamiStats>
            </>
        )}
    </div>
</div>

<script>
	function isPostPath(path: string): boolean {
		const baseUrl = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '';
		const postsPath = baseUrl.replace(/\/+$/, '') + '/posts/';
		return path.startsWith(postsPath) || path.startsWith('/posts/');
	}

	function buildTocCardHtml(headings: { text: string; slug: string; depth: number }[]): string {
		let minDepth = 10;
		for (const h of headings) {
			minDepth = Math.min(minDepth, h.depth);
		}
		const maxLevel = 2;
		const filtered = headings.filter(h => h.depth < minDepth + maxLevel);

		let itemsHtml = '';
		filtered.forEach((heading) => {
			const isH1 = heading.depth === minDepth;
			const isH2 = heading.depth === minDepth + 1;
			const isH3 = heading.depth === minDepth + 2;
			const mlClass = isH2 ? 'ml-4' : (isH3 ? 'ml-8' : '');

			let badgeHtml = '';
			if (isH1) {
				badgeHtml = '<div class="w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold bg-[var(--toc-badge-bg)] text-[var(--btn-content)]">●</div>';
			} else if (isH2) {
				badgeHtml = '<div class="w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)] shrink-0"></div>';
			} else {
				badgeHtml = '<div class="w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10 shrink-0"></div>';
			}

			const textColor = isH1
				? 'text-neutral-900 dark:text-neutral-100'
				: isH2
					? 'text-neutral-700 dark:text-neutral-300'
					: 'text-neutral-500 dark:text-neutral-400';

			itemsHtml += `<a href="#${heading.slug}" class="flex items-center gap-2 py-1.5 px-2 rounded-lg transition text-sm hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] ${mlClass} ${isH1 ? 'font-medium' : ''}">${badgeHtml}<span class="${textColor}">${heading.text}</span></a>`;
		});

		return `<div class="card-base p-4">
			<div class="flex items-center gap-2 mb-3">
				<div class="w-1 h-5 rounded-sm bg-[var(--primary)]"></div>
				<span class="text-lg font-bold text-neutral-900 dark:text-neutral-100">目录</span>
			</div>
			<div id="sidebar-toc-inner-wrapper" class="max-h-[60vh] overflow-y-auto hide-scrollbar">
				${itemsHtml}
			</div>
		</div>`;
	}

	function extractHeadings(): { text: string; slug: string; depth: number }[] {
		const content = document.querySelector('.markdown-content');
		if (!content) return [];
		const headingElements = content.querySelectorAll('h1, h2, h3, h4, h5, h6');
		const headings: { text: string; slug: string; depth: number }[] = [];
		headingElements.forEach((el) => {
			const id = el.getAttribute('id');
			const text = el.textContent || '';
			const depth = parseInt(el.tagName.charAt(1));
			if (id) {
				headings.push({ text, slug: id, depth });
			}
		});
		return headings;
	}

	let wasPostPage = isPostPath(window.location.pathname);

	function updateSidebar() {
		const sticky = document.getElementById('sidebar-sticky');
		if (!sticky) return;

		const nowIsPost = isPostPath(window.location.pathname);

		if (nowIsPost) {
			const headings = extractHeadings();
			if (headings.length > 0) {
				sticky.innerHTML = buildTocCardHtml(headings);
			}
			wasPostPage = true;
		} else {
			if (wasPostPage) {
				window.location.reload();
				return;
			}
		}
	}

	function setup() {
		window.swup?.hooks?.on('page:view', updateSidebar);
	}

	if (window.swup) {
		setup();
	} else {
		document.addEventListener('swup:enable', setup);
	}
</script>
