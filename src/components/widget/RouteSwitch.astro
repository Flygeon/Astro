---
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Route {
	name: string;
	url: string;
}

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

const routes: Route[] = [
	{ name: "CloudFlare", url: "https://flygeon.top" },
	{ name: "Github Pages", url: "https://flygeon.eu.org" },
	{ name: "Dev", url: "http://localhost:4321" },
];
---

<WidgetLayout name="线路切换" id="route-switch" class={className} style={style}>
	{routes.map((route) =>
		<ButtonLink url={route.url} label={`切换到 ${route.name} 线路`}>
			{route.name}
		</ButtonLink>
	)}
</WidgetLayout>
