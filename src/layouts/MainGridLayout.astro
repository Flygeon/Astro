---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
const hasBannerText = siteConfig.banner.enable && !!siteConfig.banner.text?.title;
const typingSpeed = siteConfig.banner.text?.typingSpeed ?? 80;
const bannerSubtitle = siteConfig.banner.text?.subtitle || "";
const bannerTitleText = title || siteConfig.banner.text?.title || "";
const isNonHomePage = !!title;
const showBannerOverlay = siteConfig.banner.enable && (hasBannerText || isNonHomePage);

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class:list={[
	"z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto",
	{ "banner-navbar": showBannerOverlay }
]}>
    <div id="navbar-wrapper" class:list={[
		"pointer-events-auto sticky top-0 transition-all",
		{ "banner-navbar-wrapper": showBannerOverlay }
	]}>
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
    {showBannerOverlay && (
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none"
             style="background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, transparent 40%, transparent 70%, rgba(0,0,0,0.4) 100%)"
        >
            <h1 class="text-white font-bold drop-shadow-lg text-center px-4 banner-title"
                style="font-size: 3.5rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5), 0 0 40px rgba(0,0,0,0.3)"
            >
                {bannerTitleText}
            </h1>
            {!isNonHomePage && siteConfig.banner.text.subtitle && (
                <p class="text-white/80 text-center px-4 mt-4 banner-subtitle"
                   style="font-size: 1.2rem; text-shadow: 0 1px 6px rgba(0,0,0,0.4)"
                >
                    <span id="banner-typing-text"></span><span id="banner-cursor" class="inline-block w-[2px] h-[1.2rem] bg-white/80 ml-0.5 align-middle" style="animation: blink 1s step-end infinite"></span>
                </p>
            )}
        </div>
    )}
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>

<style is:global>
@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}

/* Transparent navbar overlay on banner */
.banner-navbar {
    position: absolute !important;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--page-width);
    z-index: 60;
}

.banner-navbar-wrapper {
    position: static !important;
}

.banner-navbar-wrapper #navbar {
    background: transparent !important;
}

.banner-navbar-wrapper #navbar > div:first-child {
    display: none;
}

.banner-navbar-wrapper .card-base {
    background: transparent !important;
    box-shadow: none !important;
    border-radius: 0 !important;
}

.banner-navbar-wrapper .btn-plain {
    color: rgba(255,255,255,0.9) !important;
}

.banner-navbar-wrapper .btn-plain:hover {
    color: var(--primary) !important;
}
</style>

<script define:vars={{ subtitle: bannerSubtitle, speed: typingSpeed, isNonHomePage, siteTitle: siteConfig.title, homeTitle: siteConfig.banner.text?.title || '' }}>
const HOME_SUBTITLE = {JSON.stringify(siteConfig.banner.text?.subtitle || '')};

function getPageTitle() {
    const docTitle = document.title;
    const idx = docTitle.indexOf(' - ');
    if (idx > 0) {
        const before = docTitle.substring(0, idx);
        if (before === siteTitle) return '';
        return before;
    }
    return docTitle;
}

function updateBannerTitle() {
    const titleEl = document.querySelector('.banner-title');
    if (!titleEl) return;
    const pageTitle = getPageTitle();
    titleEl.textContent = pageTitle || homeTitle;
}

function updateNavbarStyle() {
    const topRow = document.getElementById('top-row');
    const navbarWrapper = document.getElementById('navbar-wrapper');
    if (!topRow || !navbarWrapper) return;
    const pageTitle = getPageTitle();
    const hasOverlay = homeTitle || pageTitle;
    if (hasOverlay) {
        topRow.classList.add('banner-navbar');
        navbarWrapper.classList.add('banner-navbar-wrapper');
    } else {
        topRow.classList.remove('banner-navbar');
        navbarWrapper.classList.remove('banner-navbar-wrapper');
    }
}

function resetTypingAnimation() {
    const el = document.getElementById('banner-typing-text');
    const cursor = document.getElementById('banner-cursor');
    if (el) el.textContent = '';
    if (cursor) cursor.style.display = 'inline-block';

    if (HOME_SUBTITLE && el) {
        let i = 0;
        function type() {
            if (i < HOME_SUBTITLE.length) {
                el.textContent += HOME_SUBTITLE.charAt(i);
                i++;
                setTimeout(type, speed);
            } else if (cursor) {
                setTimeout(() => { cursor.style.display = 'none'; }, 1500);
            }
        }
        setTimeout(type, 800);
    }
}

if (window.swup) {
    window.swup.hooks.on('page:view', () => {
        updateBannerTitle();
        updateNavbarStyle();
        const pageTitle = getPageTitle();
        if (!pageTitle) {
            resetTypingAnimation();
        }
    });
} else {
    document.addEventListener('swup:enable', () => {
        window.swup.hooks.on('page:view', () => {
            updateBannerTitle();
            updateNavbarStyle();
            const pageTitle = getPageTitle();
            if (!pageTitle) {
                resetTypingAnimation();
            }
        });
    });
}

if (!isNonHomePage && subtitle && document.getElementById('banner-typing-text')) {
    const el = document.getElementById('banner-typing-text');
    const cursor = document.getElementById('banner-cursor');
    let i = 0;
    function type() {
        if (i < subtitle.length) {
            el.textContent += subtitle.charAt(i);
            i++;
            setTimeout(type, speed);
        } else if (cursor) {
            setTimeout(() => { cursor.style.display = 'none'; }, 1500);
        }
    }
    setTimeout(type, 800);
}
</script>
</Layout>
